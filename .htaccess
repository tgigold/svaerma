# Fallback for hosts where the document root cannot point to public/:
# route every request into public/. Do NOT add "Require all denied" here –
# Apache also applies parent .htaccess files to public/ and would block the app.
# The directories next to public/ carry their own deny rules as a second layer.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
